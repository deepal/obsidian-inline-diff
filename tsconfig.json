{
  "compilerOptions": {
    "module": "ESNext", "target": "ES2020", "moduleResolution": "node",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "isolatedModules": true, "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": ["src/**/*.ts"]
}
